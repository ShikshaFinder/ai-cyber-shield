{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "shield",
  "share": "disabled",
  "autoupdate": false,
  "permission": {
    "edit": "allow",
    "webfetch": "allow",
    "external_directory": "deny",
    "bash": {
      "*": "allow",
      "rm -rf /*": "deny",
      "sudo *": "deny",
      "shutdown *": "deny",
      "reboot *": "deny"
    }
  }
}
