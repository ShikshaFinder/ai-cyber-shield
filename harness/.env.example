# Copy to .env (start.ps1 does this for you and fills in the two secrets).

# --- Secrets for the local harness (generate random values) ---
# The browser extension sends this token to the gateway.
SHIELD_TOKEN=
# Password for the OpenCode web UI / API on http://localhost:4096 (username: opencode)
OPENCODE_SERVER_PASSWORD=

# --- AI model (bring your own key) ---
# Format: provider/model, e.g. openai/gpt-5, anthropic/claude-sonnet-4-5, openrouter/<model>.
# Leave empty to use OpenCode's default model.
SHIELD_MODEL=

# Fill in the key for the provider you use (OpenCode reads these automatically).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# Azure OpenAI: SHIELD_MODEL=azure/<deployment-name>
AZURE_RESOURCE_NAME=
AZURE_API_KEY=

# --- Ports on your PC (optional) ---
SHIELD_GATEWAY_PORT=7878
SHIELD_OPENCODE_PORT=4096
